# Python and local environments
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/
build/
dist/
.env
.ipynb_checkpoints/

# Local datasets and large generated artifacts
/data/raw/
/data/processed/
/checkpoints/
/outputs/

# Reproduction (experiments/reproduction/run_r1.py)
